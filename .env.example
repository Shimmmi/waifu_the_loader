# --- PostgreSQL (контейнер из deploy/docker-compose.yml) ---
POSTGRES_USER=waifu
POSTGRES_PASSWORD=
POSTGRES_DB=waifu_loader
# Для локального запуска сервера вне Docker: порт 5440 проброшен на 127.0.0.1
DATABASE_URL=postgres://waifu:CHANGE_ME@127.0.0.1:5440/waifu_loader

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6390

# --- Сервер ---
PORT=8040
BASE_PATH=/waifu_loader
# Случайная строка >= 32 символов (подпись cookie)
COOKIE_SECRET=
# Папка с портретами (раздаётся Nginx по /waifu_loader/portraits/)
PORTRAITS_DIR=./data/portraits
PORTRAITS_PUBLIC_URL=/waifu_loader/portraits

# --- Пул waifu ---
POOL_TARGET_PER_RARITY=300
POOL_BATCH=25

# --- RouterAI (этап M3) ---
ROUTERAI_BASE_URL=
ROUTERAI_API_KEY=
