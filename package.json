{
  "name": "waifu-movers",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Waifu Movers (Грузчицы Inc.) — браузерная gacha-инкрементал игра",
  "workspaces": [
    "shared",
    "server",
    "workers",
    "client",
    "scripts"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:workers": "npm run dev -w workers",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w workers && npm run build -w client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "sim:gacha": "npm run gacha -w scripts",
    "sim:progress": "npm run progress -w scripts",
    "invite": "npm run invite -w server --"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.16.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=18.19"
  }
}
